# ==========================================
# StudyPilot AI - Environment Configuration
# ==========================================

# Application
APP_NAME=StudyPilot AI
ENVIRONMENT=development
DEBUG=True

# OpenAI API Key (Optional: system automatically uses deterministic mock embeddings/answers if omitted)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/studypilot_db
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword2026@localhost:5432/studypilot_db

# Security & Authentication
SECRET_KEY=studypilot-super-secret-production-grade-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
